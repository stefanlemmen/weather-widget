{
  "ci": {
    "collect": {
      "startServerCommand": "PROVIDER_MODE=fixtures pnpm preview",
      "startServerReadyPattern": "Preview listening",
      "url": ["http://localhost:4173/vanilla/", "http://localhost:4173/react/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "/vanilla/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              { "maxNumericValue": 51200 }
            ]
          }
        },
        {
          "matchingUrlPattern": "/react/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              { "maxNumericValue": 102400 }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
