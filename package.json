{
  "name": "weather-widget-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present dev",
    "build": "pnpm --recursive --if-present build && node scripts/write-vercel-output.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && pnpm --recursive --if-present typecheck",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icon-svgs:check": "pnpm --filter @weather-widget/widget write-icon-svgs && git diff --exit-code -- packages/widget/generated/icon-svgs.ts",
    "test": "vitest run && pnpm --recursive --if-present test",
    "lighthouse": "lhci autorun",
    "preview": "node scripts/preview.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.5",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@weather-widget/proxy": "workspace:*",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "hono": "4.13.14",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "valibot": "1.5.0",
    "vitest": "4.1.12"
  }
}
